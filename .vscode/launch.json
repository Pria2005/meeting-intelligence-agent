{
  "version": "0.2.0",
  "configurations": [
    { "name": "API (FastAPI)", "type": "debugpy", "request": "launch", "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"], "cwd": "${workspaceFolder}/backend", "envFile": "${workspaceFolder}/.env" },
    { "name": "UI (Streamlit)", "type": "debugpy", "request": "launch", "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"], "cwd": "${workspaceFolder}/frontend", "envFile": "${workspaceFolder}/.env" },
    { "name": "Tests", "type": "debugpy", "request": "launch", "module": "pytest", "cwd": "${workspaceFolder}/backend" }
  ],
  "compounds": [ { "name": "API + UI", "configurations": ["API (FastAPI)", "UI (Streamlit)"] } ]
}
