# Copy to .env and edit. Never commit .env.

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO
API_URL=http://127.0.0.1:8000

# ---- Auth (PRD Appendix B: single-user locally; enable for multi-user) ----
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
ALLOW_REGISTRATION=true

# ---- LLM ----
# auto = groq if GROQ_API_KEY set, else openai if OPENAI_API_KEY set, else offline "heuristic" analyser
LLM_PROVIDER=auto
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# Any OpenAI-compatible server (Ollama, vLLM, LM Studio):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=none
# Set false to forbid sending any transcript text to external providers
ALLOW_EXTERNAL_LLM=true

# ---- Speech-to-text ----
WHISPER_MODEL_SIZE=base      # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto
# WHISPER_LANGUAGE=en        # leave unset to auto-detect

# ---- Diarization (optional) ----
DIARIZATION_ENABLED=false
# HF_TOKEN=

# ---- Embeddings ----
EMBEDDING_BACKEND=sentence-transformers   # or "hash" (offline, lower quality)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage / limits ----
# DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/meetings
MAX_UPLOAD_MB=200
